APP_NAME="LawFirm ERP"
APP_ENV=local
APP_KEY=

# أوّل مالك منصّة (B4): إن ضُبط الاثنان، يُنشئ DatabaseSeeder حساب admin مرّة عند الإقلاع
# (idempotent). المسار الرسمي لأوّل مدير في الإنتاج — لا حاجة لـ tinker. دوِّر كلمة المرور بعد
# أوّل دخول. اتركهما فارغين في التطوير (يبقى الحساب التجريبي test@example.com).
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=lawfirm
DB_USERNAME=lawfirm
DB_PASSWORD=secret

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# تخزين مستندات القضايا — Cloudflare R2 (متوافق S3). قرص "r2" في config/filesystems.
# تُضبط القيم الفعلية كأسرار في بيئة النشر (Render) لا هنا. في التطوير/الاختبار اترك
# LEGAL_DOCUMENTS_DISK=local لتفادي الاتصال بـ R2.
LEGAL_DOCUMENTS_DISK=r2
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_DEFAULT_REGION=auto
R2_BUCKET=
R2_ENDPOINT=

# النسخ الاحتياطي لقاعدة البيانات — دلو R2 منفصل عن الوثائق (قرص "backups"، Phase 13).
# يُشغّله الأمر backup:run (يوميّاً عبر cron). تُضبط القيم كأسرار في بيئة النشر لا هنا.
R2_BACKUP_ACCESS_KEY_ID=
R2_BACKUP_SECRET_ACCESS_KEY=
R2_BACKUP_DEFAULT_REGION=auto
R2_BACKUP_BUCKET=
R2_BACKUP_ENDPOINT=

# جدولة مزامنة البصمة (Pull) — B3. معطّلة افتراضياً: أجهزة البصمة على شبكة المكتب (LAN) لا
# يصلها المضيف السحابي، والمسار الحيّ Push. اضبطها true فقط على مُشغّل schedule داخل شبكة
# الشركة (أو VPN)؛ عندها تُجدوَل biometric:sync كل دقيقة (وتقتصر على أجهزة api_mode=pull).
BIOMETRIC_PULL_SCHEDULE_ENABLED=false

VITE_APP_NAME="${APP_NAME}"
