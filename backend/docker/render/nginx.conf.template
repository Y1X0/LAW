# nginx للإنتاج (Render) — واجهة HTTP أمام php-fpm في نفس الحاوية.
# ${PORT} فقط يُستبدَل عند الإقلاع (envsubst)؛ بقيّة متغيّرات nginx ($uri…) تبقى كما هي.
worker_processes auto;
daemon off;
pid /tmp/nginx.pid;
error_log /dev/stderr warn;

events { worker_connections 1024; }

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    access_log /dev/stdout;
    sendfile on;
    client_max_body_size 20m;

    server {
        listen ${PORT};
        server_name _;
        root /var/www/html/public;
        index index.php;

        # OPS-2: رؤوس أمان (تُرسَل حتى مع الأخطاء عبر always). لا CSP هنا عمداً —
        # يُضاف لاحقاً بعد اختبار الواجهة. HSTS آمن لأن Render يقدّم الواجهة عبر HTTPS.
        # ملاحظة nginx: لا تُضِف add_header داخل أي location وإلا أُلغيت هذه الوراثة.
        add_header X-Frame-Options "DENY" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Strict-Transport-Security "max-age=15768000; includeSubDomains" always;

        location / {
            try_files $uri $uri/ /index.php?$query_string;
        }

        location ~ \.php$ {
            fastcgi_pass 127.0.0.1:9000;
            fastcgi_index index.php;
            fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
            include fastcgi_params;
        }

        location ~ /\.(?!well-known).* {
            deny all;
        }
    }
}
