# عنوان الـ API الأساسي للباك-إند (Laravel). أثناء التطوير عبر بروكسي Vite يكفي "/api".
VITE_API_URL=/api

# مراقبة أخطاء الواجهة (Sentry) — خاملة ما لم يُضبط الـDSN. تُحقن وقت البناء.
# اضبطها في لوحة Render لخدمة law-web ثم أعد البناء. راجع docs/OBSERVABILITY.md.
VITE_SENTRY_DSN=
VITE_SENTRY_RELEASE=
VITE_SENTRY_ENVIRONMENT=
VITE_SENTRY_TRACES_SAMPLE_RATE=0
